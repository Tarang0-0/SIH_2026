# ==============================================================================
# RailETA — Environment Configuration Template
# Problem Statement 26028: Dynamic Forecast of ETA for Coaching Trains
# ==============================================================================

# Runtime Environment (development | production)
ENVIRONMENT=production
DATA_SOURCE_MODE=REAL

# Real External Services API Keys
RAILRADAR_API_KEY=your_railradar_api_key_here
MAPTILER_API_KEY=your_maptiler_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENTOPOGRAPHY_API_KEY=your_opentopography_api_key_here

# Supabase PostgreSQL Database (Optional / Default Mock fallback)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Frontend Client Public Envs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_api_key_here
