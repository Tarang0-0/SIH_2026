# Backend provider configuration. Keep real credentials in an untracked .env.
RAILRADAR_API_KEY=
RAILRADAR_API_BASE_URL=https://api.railradar.in/v1
INDIAN_RAIL_API_KEY=
INDIAN_RAIL_API_BASE_URL=https://indianrailapi.com/api/v2
OPENWEATHER_API_KEY=

# Optional generic official-status provider.
OFFICIAL_RAIL_STATUS_URL=
OFFICIAL_RAIL_STATUS_TOKEN=
OFFICIAL_RAIL_STATUS_POLL_SECONDS=30
OFFICIAL_RAIL_STATUS_MAX_AGE_SECONDS=300

# Optional authorised railway network-signal feed.
RAIL_NETWORK_SIGNALS_URL=
RAIL_NETWORK_SIGNALS_PROVIDER=
RAIL_NETWORK_SIGNALS_TOKEN=
RAIL_NETWORK_SIGNALS_ALLOW_HTTP=false

# Optional local paths for runtime state.
RAILPULSE_FEEDBACK_DB=
RAILPULSE_MODEL_REGISTRY=

# Daily learning job. Keep collection disabled until an authorised provider
# and a small approved list of trains are configured.
RAILPULSE_DAILY_COLLECT=false
RAILPULSE_DAILY_TRAIN_NUMBERS=12951,12952
RAILPULSE_DAILY_COLLECTION_INTERVAL_SECONDS=300
RAILPULSE_DAILY_COLLECTION_SECONDS=3600

# Weather cache duration in seconds.
OPENWEATHER_CACHE_SECONDS=900

# Frontend origins allowed to call the backend.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
