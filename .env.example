# Backend provider configuration. Keep real credentials in an untracked .env.
RAILRADAR_API_KEY=
RAILRADAR_API_BASE_URL=
INDIAN_RAIL_API_KEY=
INDIAN_RAIL_API_BASE_URL=
OPENWEATHER_API_KEY=
OPENWEATHER_API_URL=

# Optional generic official-status provider.
OFFICIAL_RAIL_STATUS_URL=
OFFICIAL_RAIL_STATUS_TOKEN=
OFFICIAL_RAIL_STATUS_POLL_SECONDS=30
OFFICIAL_RAIL_STATUS_MAX_AGE_SECONDS=300

# Optional authorised railway network-signal feed.
RAIL_NETWORK_SIGNALS_URL=
RAIL_NETWORK_SIGNALS_PROVIDER=
RAIL_NETWORK_SIGNALS_TOKEN=
RAIL_NETWORK_SIGNALS_ALLOW_HTTP=false

# Optional local paths for runtime state.
RAILPULSE_FEEDBACK_DB=
RAILPULSE_MODEL_REGISTRY=

# Daily learning job.
# Set RAILPULSE_DAILY_COLLECT=true to have the API automatically collect live
# train data and retrain models every night at 02:00 IST (via APScheduler).
# No external cron service is needed — the scheduler runs inside the FastAPI process.
# If ir_train.csv is absent (e.g. Render free tier), the online-only trainer
# (scripts/21_train_online_only.py) is used automatically instead.
RAILPULSE_DAILY_COLLECT=false
RAILPULSE_DAILY_TRAIN_NUMBERS=
RAILPULSE_DAILY_COLLECTION_INTERVAL_SECONDS=300
RAILPULSE_DAILY_COLLECTION_SECONDS=3600

# Weather cache duration in seconds.
OPENWEATHER_CACHE_SECONDS=900

# Frontend origins allowed to call the backend.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Operator/admin authentication. Generate a long random token; never commit
# the real values. The frontend login exchanges the username/password for a
# short-lived signed session token.
RAILPULSE_ADMIN_TOKEN=
RAILPULSE_ADMIN_USERNAME=
RAILPULSE_ADMIN_PASSWORD=

# Only enable when a trusted reverse proxy strips and rewrites these headers.
RATE_LIMIT_TRUST_PROXY_HEADERS=false
