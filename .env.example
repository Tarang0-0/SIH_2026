# Backend provider configuration. Keep real credentials in an untracked .env.
RAILRADAR_API_KEY=
INDIAN_RAIL_API_KEY=
OPENWEATHER_API_KEY=

# Optional authorised railway network-signal feed.
RAIL_NETWORK_SIGNALS_URL=
RAIL_NETWORK_SIGNALS_PROVIDER=
RAIL_NETWORK_SIGNALS_TOKEN=

# Frontend origins allowed to call the backend.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
