# Backend API origin used by the browser bundle.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Map integrations. Leave blank to disable the corresponding layer/provider.
NEXT_PUBLIC_LEAFLET_CSS_URL=https://unpkg.com/leaflet@1.9.4/dist/leaflet.css
NEXT_PUBLIC_LEAFLET_SCRIPT_URL=https://unpkg.com/leaflet@1.9.4/dist/leaflet.js
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
NEXT_PUBLIC_RAILWAY_TILE_URL=https://{s}.tiles.openrailwaymap.org/standard/{z}/{x}/{y}.png
NEXT_PUBLIC_RAILWAY_TILE_ATTRIBUTION=&copy; OpenRailwayMap contributors
NEXT_PUBLIC_MAP_SEARCH_URL=https://www.google.com/maps/search/?api=1&query=
